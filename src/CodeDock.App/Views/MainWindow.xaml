<Window x:Class="CodeDock.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:CodeDock.App.ViewModels"
        xmlns:controls="clr-namespace:CodeDock.App.Controls"
        xmlns:models="clr-namespace:CodeDock.Core.Models;assembly=CodeDock.Core"
        Title="CodeDock"
        Icon="/Assets/CodeDock.Mark.png"
        Width="1240"
        Height="760"
        MinWidth="900"
        MinHeight="580"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing"
        PreviewKeyDown="OnPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding AddProjectCommand}" />
    </Window.InputBindings>

    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0D1016" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="/Assets/CodeDock.Mark.png" Width="25" Height="25" />
                    <TextBlock Text="CodeDock" Margin="9,0,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Margin="12,0,0,0" Padding="7,3" Background="#171D29" CornerRadius="4">
                        <TextBlock Text="WORKSPACE MANAGER" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowButton}" ToolTip="Minimize" Click="OnMinimizeClick">
                        <Path Width="11" Height="1" Data="M 0,0.5 L 11,0.5" Stroke="{StaticResource TextBrush}" StrokeThickness="1" SnapsToDevicePixels="True" />
                    </Button>
                    <Button Style="{StaticResource WindowButton}" ToolTip="Maximize" Click="OnMaximizeClick">
                        <Path Width="10" Height="10" Data="M 0.5,0.5 L 9.5,0.5 9.5,9.5 0.5,9.5 Z" Stroke="{StaticResource TextBrush}" StrokeThickness="1" Fill="Transparent" SnapsToDevicePixels="True" />
                    </Button>
                    <Button x:Name="CloseWindowButton" Style="{StaticResource WindowButton}" ToolTip="Close" Click="OnCloseClick">
                        <Path Width="10" Height="10" Data="M 0.8,0.8 L 9.2,9.2 M 9.2,0.8 L 0.8,9.2" Stroke="{StaticResource TextBrush}" StrokeThickness="1.2" SnapsToDevicePixels="True" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ListBox x:Name="ProjectTabs"
                         ItemsSource="{Binding CodeProjects}"
                         SelectedItem="{Binding SelectedCodeProject, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         AllowDrop="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,7,0" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnTabPreviewMouseLeftButtonDown" />
                            <EventSetter Event="PreviewMouseMove" Handler="OnTabPreviewMouseMove" />
                            <EventSetter Event="Drop" Handler="OnTabDrop" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="TabChrome"
                                                Padding="10,5"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource StrokeBrightBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProjectTabViewModel}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Close tab only" Click="OnCloseTabOnlyClick" />
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <Border Width="23" Height="23" CornerRadius="6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#143D59" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.VisualStudio2022}">
                                                    <Setter Property="Background" Value="#3D2761" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.Antigravity}">
                                                    <Setter Property="Background" Value="#3B2A14" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="9" FontFamily="Cascadia Code, Consolas" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&lt;&gt;" />
                                                <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.VisualStudio2022}">
                                                        <Setter Property="Text" Value="VS" />
                                                        <Setter Property="Foreground" Value="#C4A7FF" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.Antigravity}">
                                                        <Setter Property="Text" Value="AG" />
                                                        <Setter Property="Foreground" Value="#FFB84D" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding Name}"
                                           MinWidth="70"
                                           MaxWidth="175"
                                           Margin="8,0,2,0"
                                           Padding="1"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Ellipse Width="6" Height="6" Margin="7,0,3,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFolderAvailable}" Value="False">
                                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Button Style="{StaticResource GhostButton}"
                                        Content="×"
                                        Margin="4,0,0,0"
                                        Padding="5,1"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        FontSize="15"
                                        ToolTip="Close IDE and tab"
                                        Click="OnRemoveProjectClick" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="AppsDropdownButton"
                            Padding="13,7"
                            ToolTip="Manage and switch Apps &amp; Browser windows"
                            Click="OnAppsDropdownButtonClick">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Setter Property="Background" Value="#141B29" />
                                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAppWorkspaceSelected}" Value="True">
                                        <Setter Property="Background" Value="#1D2B44" />
                                        <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasAnyAppNotification}" Value="True">
                                        <Setter Property="BorderBrush" Value="#FF4D5E" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#FF4D5E" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAnyAppNotification}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding AppsMenuHeader}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Popup x:Name="AppsDropdownPopup"
                           PlacementTarget="{Binding ElementName=AppsDropdownButton}"
                           Placement="Bottom"
                           VerticalOffset="6"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Width="320"
                                Padding="12"
                                Background="#131824"
                                BorderBrush="{StaticResource StrokeBrightBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="APPS &amp; BROWSERS"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Margin="4,2,4,8" />

                                <TextBlock Text="No apps added yet. Choose one below."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           Margin="4,2,4,10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAppWorkspaces}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding AppWorkspaces}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ProjectTabViewModel}">
                                            <Border Margin="0,0,0,4"
                                                    Padding="6,5"
                                                    CornerRadius="7"
                                                    BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrightBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Style="{StaticResource GhostButton}"
                                                            HorizontalContentAlignment="Left"
                                                            Padding="4,3"
                                                            Click="OnSelectAppWorkspaceClick">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="22" Height="22" CornerRadius="5">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#2D235A" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.MicrosoftOutlook}">
                                                                                <Setter Property="Background" Value="#123866" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.WhatsApp}">
                                                                                <Setter Property="Background" Value="#11422C" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.Spotify}">
                                                                                <Setter Property="Background" Value="#143D28" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.Obsidian}">
                                                                                <Setter Property="Background" Value="#381D52" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.MicrosoftEdge}">
                                                                                <Setter Property="Background" Value="#143A4A" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.GoogleChrome}">
                                                                                <Setter Property="Background" Value="#422B14" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock FontSize="8.5" FontFamily="Cascadia Code, Consolas" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="TM" />
                                                                            <Setter Property="Foreground" Value="#B49BFF" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.MicrosoftOutlook}">
                                                                                    <Setter Property="Text" Value="OL" />
                                                                                    <Setter Property="Foreground" Value="#60A5FA" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.WhatsApp}">
                                                                                    <Setter Property="Text" Value="WA" />
                                                                                    <Setter Property="Foreground" Value="#34D399" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.Spotify}">
                                                                                    <Setter Property="Text" Value="SP" />
                                                                                    <Setter Property="Foreground" Value="#4ADE80" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.Obsidian}">
                                                                                    <Setter Property="Text" Value="OB" />
                                                                                    <Setter Property="Foreground" Value="#C084FC" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.MicrosoftEdge}">
                                                                                    <Setter Property="Text" Value="ED" />
                                                                                    <Setter Property="Foreground" Value="#38BDF8" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.GoogleChrome}">
                                                                                    <Setter Property="Text" Value="CH" />
                                                                                    <Setter Property="Foreground" Value="#FBBF24" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}"
                                                                       MaxWidth="155"
                                                                       Margin="9,0,6,0"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasAssociatedWindow}" Value="True">
                                                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <Ellipse Width="8" Height="8" Fill="#FF4D5E" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="New notification or unread message">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasUnreadNotification}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource GhostButton}"
                                                            Content="×"
                                                            Padding="6,1"
                                                            FontSize="14"
                                                            Foreground="{StaticResource TextMutedBrush}"
                                                            ToolTip="Close app and remove from list"
                                                            Click="OnRemoveProjectClick" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,8" />

                                <TextBlock Text="ADD NEW INSTANCE"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Margin="4,0,4,6" />
                                <UniformGrid Columns="2">
                                    <Button Style="{StaticResource GhostButton}"
                                            Content="＋ Teams"
                                            HorizontalContentAlignment="Left"
                                            Margin="2"
                                            Padding="8,6"
                                            Click="OnAddTeamsClick" />
                                    <Button Style="{StaticResource GhostButton}"
                                            Content="＋ Outlook"
                                            HorizontalContentAlignment="Left"
                                            Margin="2"
                                            Padding="8,6"
                                            Click="OnAddOutlookClick" />
                                    <Button Style="{StaticResource GhostButton}"
                                            Content="＋ WhatsApp"
                                            HorizontalContentAlignment="Left"
                                            Margin="2"
                                            Padding="8,6"
                                            Click="OnAddWhatsAppClick" />
                                    <Button Style="{StaticResource GhostButton}"
                                            Content="＋ Spotify"
                                            HorizontalContentAlignment="Left"
                                            Margin="2"
                                            Padding="8,6"
                                            Click="OnAddSpotifyClick" />
                                    <Button Style="{StaticResource GhostButton}"
                                            Content="＋ Obsidian"
                                            HorizontalContentAlignment="Left"
                                            Margin="2"
                                            Padding="8,6"
                                            Click="OnAddObsidianClick" />
                                    <Button Style="{StaticResource GhostButton}"
                                            Content="＋ Edge window"
                                            HorizontalContentAlignment="Left"
                                            Margin="2"
                                            Padding="8,6"
                                            Click="OnAddEdgeClick" />
                                    <Button Style="{StaticResource GhostButton}"
                                            Content="＋ Chrome window"
                                            HorizontalContentAlignment="Left"
                                            Margin="2"
                                            Padding="8,6"
                                            Click="OnAddChromeClick" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <Button Grid.Column="2"
                        Style="{StaticResource PrimaryButton}"
                        Content="＋  Add workspace"
                        Margin="8,0,10,0"
                        ToolTip="Add project (Ctrl+T)"
                        Command="{Binding AddProjectCommand}" />

                <Menu Grid.Column="3" VerticalAlignment="Center">
                    <MenuItem Header="•••" FontSize="16" Padding="12,7" ToolTip="Settings">
                        <MenuItem Header="Dark theme" IsCheckable="True" IsChecked="True" IsEnabled="False" />
                        <MenuItem Header="Window Manager mode" IsCheckable="True" IsChecked="True" IsEnabled="False" />
                    </MenuItem>
                </Menu>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="24">
            <Grid x:Name="EmptyState">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProject}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                    <Border Width="108" Height="108" Background="#121827" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="26">
                        <Image Source="/Assets/CodeDock.Mark.png" Width="82" Height="82" />
                    </Border>
                    <TextBlock Text="Your workspaces, one dock." FontSize="28" FontWeight="SemiBold" Margin="0,24,0,8" HorizontalAlignment="Center" />
                    <TextBlock Text="Bring every VS Code, Visual Studio, and Antigravity project into a focused, persistent workspace."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="14"
                               LineHeight="22"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button Style="{StaticResource PrimaryButton}" Content="＋  Add your first workspace" Margin="0,24,0,0" Command="{Binding AddProjectCommand}" />
                    <TextBlock Text="Ctrl + T" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,12,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid x:Name="WorkspaceDashboard" DataContext="{Binding SelectedProject}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEmbedded}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.65*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.ColumnSpan="3" Padding="28" Background="{StaticResource HeroGradient}" BorderBrush="#35415B" BorderThickness="1" CornerRadius="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Padding="8,4" Background="#21324A" CornerRadius="12">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="WORKSPACE READY" Foreground="{StaticResource SuccessBrush}" FontSize="9" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="30" FontWeight="SemiBold" Margin="0,13,0,5" />
                            <TextBlock Text="A focused home for this project and its preferred development environment."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13" />
                        </StackPanel>
                        <Image Grid.Column="1" Source="/Assets/CodeDock.Mark.png" Width="100" Height="100" Margin="30,-8,2,-8" Opacity="0.9" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="WORKSPACE DETAILS" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Display name" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,5,10,0"
                                         Padding="9,6"
                                         Background="#0D1016"
                                         Foreground="{StaticResource TextBrush}"
                                         BorderBrush="{StaticResource StrokeBrush}"
                                         BorderThickness="1"
                                         FontSize="12"
                                         KeyDown="OnProjectNameKeyDown" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource GhostButton}"
                                    Content="Save name"
                                    VerticalAlignment="Bottom"
                                    Padding="12,6"
                                    Click="OnSaveProjectNameClick" />
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBrowserWorkspace}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Startup URL (e.g. https://outlook.office.com or https://web.whatsapp.com)"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" />
                                <TextBox Text="{Binding LaunchTargetUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,5,10,0"
                                         Padding="9,6"
                                         Background="#0D1016"
                                         Foreground="{StaticResource TextBrush}"
                                         BorderBrush="{StaticResource StrokeBrush}"
                                         BorderThickness="1"
                                         FontFamily="Cascadia Mono, Consolas"
                                         FontSize="12"
                                         KeyDown="OnLaunchTargetUrlKeyDown" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource GhostButton}"
                                    Content="Save URL"
                                    VerticalAlignment="Bottom"
                                    Padding="12,6"
                                    Click="OnSaveLaunchTargetUrlClick" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,18" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" Background="#182133" CornerRadius="7" VerticalAlignment="Top">
                                <TextBlock Text="⌁" Foreground="{StaticResource CyanBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Project folder" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAppOrBrowserWorkspace}" Value="True">
                                                    <Setter Property="Text" Value="Application workspace data folder" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBrowserWorkspace}" Value="True">
                                                    <Setter Property="Text" Value="Shared CodeDock browser profile" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding FolderPath}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,18" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" Background="#132A29" CornerRadius="7" VerticalAlignment="Top">
                                <TextBlock Text="✓" Foreground="{StaticResource SuccessBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Environment" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                <TextBlock Text="{Binding EnvironmentDisplayName}" Margin="0,5,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Grid.Column="2">
                    <Border Padding="22" Margin="0,0,0,18">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCodeWorkspace}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="OPEN WITH" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="Preferred environment" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,3" />
                            <TextBlock Text="Choose which IDE will own this workspace."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" />
                            <Border Margin="0,18,0,0" Padding="3" Background="#0D1016" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Click="OnSelectVSCodeClick"
                                            ToolTipService.ShowOnDisabled="True">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource EnvironmentButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.VisualStudioCode}">
                                                        <Setter Property="Background" Value="#163450" />
                                                        <Setter Property="BorderBrush" Value="#246694" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsVisualStudioCodeAvailable}" Value="False">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="Opacity" Value="0.38" />
                                                        <Setter Property="ToolTip" Value="VS Code already has a tab for this folder." />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&lt;&gt;" FontFamily="Cascadia Code, Consolas" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" Margin="0,0,7,0" />
                                            <TextBlock Text="VS Code" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1"
                                            Click="OnSelectVisualStudioClick"
                                            ToolTipService.ShowOnDisabled="True">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource EnvironmentButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.VisualStudio2022}">
                                                        <Setter Property="Background" Value="#342350" />
                                                        <Setter Property="BorderBrush" Value="#6843A0" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsVisualStudioAvailable}" Value="False">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="Opacity" Value="0.38" />
                                                        <Setter Property="ToolTip" Value="Visual Studio already has a tab for this folder." />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="VS" Foreground="#C4A7FF" FontWeight="Bold" Margin="0,0,7,0" />
                                            <TextBlock Text="Visual Studio" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2"
                                            Click="OnSelectAntigravityClick"
                                            ToolTipService.ShowOnDisabled="True">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource EnvironmentButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.Antigravity}">
                                                        <Setter Property="Background" Value="#473116" />
                                                        <Setter Property="BorderBrush" Value="#9A6423" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsAntigravityAvailable}" Value="False">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="Opacity" Value="0.38" />
                                                        <Setter Property="ToolTip" Value="Antigravity already has a tab for this folder." />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="AG" Foreground="#FFB84D" FontWeight="Bold" Margin="0,0,7,0" />
                                            <TextBlock Text="Antigravity" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" Background="#261F38" CornerRadius="7" VerticalAlignment="Top">
                                <TextBlock Text="↗" Foreground="#C4A7FF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="IDE CONTROL" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="Bold" />
                                <TextBlock Text="Launch or recall" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,3" />
                                <TextBlock Text="{Binding IdeStatus}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           LineHeight="17"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SolutionDisplayName, StringFormat=Solution: {0}}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="10"
                                           Margin="0,6,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.VisualStudio2022}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Style="{StaticResource PrimaryButton}"
                                        Content="Open in CodeDock"
                                        HorizontalAlignment="Left"
                                        Margin="0,14,0,0"
                                        Click="OnOpenEmbeddedIdeClick" />
                                <Button Content="Embed experimentally"
                                        HorizontalAlignment="Left"
                                        Margin="0,9,0,0"
                                        Click="OnEmbedIdeClick" />
                                <Button Style="{StaticResource GhostButton}"
                                        Content="Associate existing window"
                                        HorizontalAlignment="Left"
                                        Margin="0,7,0,0"
                                        Command="{Binding DataContext.AssociateExistingIdeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Change solution"
                                        HorizontalAlignment="Left"
                                        Margin="0,7,0,0"
                                        Command="{Binding DataContext.ChangeVisualStudioSolutionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.VisualStudio2022}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <ItemsControl x:Name="EmbeddedHosts"
                          ItemsSource="{Binding Projects}"
                          VirtualizingPanel.IsVirtualizing="False">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="VerticalAlignment" Value="Stretch" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ProjectTabViewModel}">
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsEmbedded}" Value="True" />
                                                <Condition Binding="{Binding IsSelected}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="46" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource StrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10,10,0,0"
                                    Padding="14,7">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Padding="8,4" Background="#342350" CornerRadius="10">
                                            <TextBlock Text="EXPERIMENTAL EMBED" Foreground="#C4A7FF" FontSize="9" FontWeight="Bold" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Style="{StaticResource GhostButton}"
                                            Content="Return to dashboard"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Height="30"
                                            MinWidth="142"
                                            Padding="12,4"
                                            Click="OnExitEmbeddedClick" />
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Background="#080A0E" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1,0,1,1">
                                <controls:ExternalWindowHost WindowHandle="{Binding EmbeddedWindowHandle, TargetNullValue=0}"
                                                             RequiresContentResizeKick="{Binding RequiresEmbeddedResizeKick}"
                                                             RequiresElectronRenderKick="{Binding RequiresElectronRenderKick}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Border Grid.Row="1"
                Grid.RowSpan="2"
                Panel.ZIndex="100"
                Background="#C20A0D13"
                Cursor="Wait">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="250"
                    Padding="28,22"
                    Background="#F2181D28"
                    BorderBrush="{StaticResource StrokeBrightBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel HorizontalAlignment="Center">
                    <Path Width="38"
                          Height="38"
                          Data="M 19,3 A 16,16 0 1 1 3,19"
                          Stretch="None"
                          Stroke="{StaticResource CyanBrush}"
                          StrokeThickness="3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="LoadingSpinnerRotation" />
                        </Path.RenderTransform>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="LoadingSpinnerRotation"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0"
                                                         To="360"
                                                         Duration="0:0:0.8"
                                                         RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>
                    <TextBlock Text="Working…"
                               Margin="0,14,0,4"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusMessage}"
                               MaxWidth="360"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.Row="3" Background="#0D1016" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="WINDOW MANAGER" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
