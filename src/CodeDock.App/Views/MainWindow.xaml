<Window x:Class="CodeDock.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CodeDock.App.ViewModels"
        xmlns:models="clr-namespace:CodeDock.Core.Models;assembly=CodeDock.Core"
        xmlns:converters="clr-namespace:CodeDock.App.Converters"
        Title="CodeDock"
        Width="1180"
        Height="720"
        MinWidth="760"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <converters:DevelopmentEnvironmentNameConverter x:Key="EnvironmentNameConverter" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding AddProjectCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Border Width="34" Height="34" Background="{StaticResource AccentBrush}" CornerRadius="8">
                        <TextBlock Text="CD" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="CodeDock" Margin="10,0,0,0" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <TabControl x:Name="ProjectTabs"
                            Grid.Column="1"
                            ItemsSource="{Binding Projects}"
                            SelectedItem="{Binding SelectedProject}"
                            Background="Transparent"
                            BorderThickness="0"
                            AllowDrop="True">
                    <TabControl.Resources>
                        <Style TargetType="TabPanel">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style TargetType="TabItem">
                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <EventSetter Event="PreviewMouseMove" Handler="OnTabPreviewMouseMove" />
                            <EventSetter Event="Drop" Handler="OnTabDrop" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="TabBorder" Margin="2,0" Padding="10,6" Background="Transparent" CornerRadius="6">
                                            <ContentPresenter ContentSource="Header" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="#292E38" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource RaisedSurfaceBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                    <TabControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProjectTabViewModel}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="22" Height="22" Margin="0,0,7,0" CornerRadius="5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1687C8" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.VisualStudio2022}">
                                                    <Setter Property="Background" Value="#6C3BAA" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&lt;&gt;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.VisualStudio2022}">
                                                        <Setter Property="Text" Value="VS" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         MinWidth="70"
                                         MaxWidth="170"
                                         Padding="2"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontWeight="SemiBold"
                                         ToolTip="Edit project name"
                                         LostKeyboardFocus="OnProjectNameLostFocus"
                                         KeyDown="OnProjectNameKeyDown" />
                                <Button Style="{StaticResource IconButton}"
                                        Content="×"
                                        Margin="5,0,-5,0"
                                        FontSize="15"
                                        ToolTip="Remove tab"
                                        Command="{Binding DataContext.RemoveProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <Grid Height="0" />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>

                <Button Grid.Column="2"
                        Style="{StaticResource IconButton}"
                        Content="+"
                        Margin="8,0,4,0"
                        FontSize="22"
                        ToolTip="Add project (Ctrl+T)"
                        Command="{Binding AddProjectCommand}" />

                <Menu Grid.Column="3" VerticalAlignment="Center">
                    <MenuItem Header="⚙" FontSize="17" ToolTip="Settings">
                        <MenuItem Header="Dark theme" IsCheckable="True" IsChecked="True" IsEnabled="False" />
                        <MenuItem Header="Window Manager mode" IsCheckable="True" IsChecked="True" IsEnabled="False" />
                    </MenuItem>
                </Menu>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProject}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Width="70" Height="70" Background="{StaticResource RaisedSurfaceBrush}" CornerRadius="18">
                    <TextBlock Text="+" FontSize="36" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Dock your first project" FontSize="25" FontWeight="SemiBold" Margin="0,22,0,7" HorizontalAlignment="Center" />
                <TextBlock Text="Add a repository folder and CodeDock will keep it ready as a tab."
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="14"
                           TextAlignment="Center" />
                <Button Content="Add project" Margin="0,22,0,0" Command="{Binding AddProjectCommand}" />
            </StackPanel>

            <Border Padding="32" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProject}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid DataContext="{Binding SelectedProject}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="48" Height="48" Background="{StaticResource AccentBrush}" CornerRadius="10">
                            <TextBlock Text="{}{ }" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="25" FontWeight="SemiBold" />
                            <TextBlock Text="Window Manager workspace" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,30,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Folder" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding FolderPath}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Text="Status" Foreground="{StaticResource MutedTextBrush}" Margin="0,14,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,14,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Ready" />
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFolderAvailable}" Value="False">
                                            <Setter Property="Text" Value="Folder unavailable" />
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Row="2" Text="Open with" Foreground="{StaticResource MutedTextBrush}" Margin="0,14,0,0" />
                        <ComboBox Grid.Row="2"
                                  Grid.Column="1"
                                  Width="190"
                                  Margin="0,10,0,0"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{Binding DataContext.AvailableEnvironments, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding PreferredEnvironment}"
                                  SelectionChanged="OnPreferredEnvironmentChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnvironmentNameConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Border Grid.Row="2" Margin="0,34,0,0" Padding="18" Background="{StaticResource RaisedSurfaceBrush}" CornerRadius="7" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="VS Code integration" FontWeight="SemiBold" />
                            <TextBlock Text="Launching and associating VS Code and Visual Studio 2022 windows arrives in Milestones 3 and 4. This dashboard never terminates external processes."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="Window Manager" Foreground="{StaticResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
