<Window x:Class="CodeDock.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:CodeDock.App.ViewModels"
        xmlns:models="clr-namespace:CodeDock.Core.Models;assembly=CodeDock.Core"
        Title="CodeDock"
        Icon="/Assets/CodeDock.Mark.png"
        Width="1240"
        Height="760"
        MinWidth="900"
        MinHeight="580"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing"
        PreviewKeyDown="OnPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding AddProjectCommand}" />
    </Window.InputBindings>

    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0D1016" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="/Assets/CodeDock.Mark.png" Width="25" Height="25" />
                    <TextBlock Text="CodeDock" Margin="9,0,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Margin="12,0,0,0" Padding="7,3" Background="#171D29" CornerRadius="4">
                        <TextBlock Text="WORKSPACE MANAGER" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowButton}" ToolTip="Minimize" Click="OnMinimizeClick">
                        <Path Width="11" Height="1" Data="M 0,0.5 L 11,0.5" Stroke="{StaticResource TextBrush}" StrokeThickness="1" SnapsToDevicePixels="True" />
                    </Button>
                    <Button Style="{StaticResource WindowButton}" ToolTip="Maximize" Click="OnMaximizeClick">
                        <Path Width="10" Height="10" Data="M 0.5,0.5 L 9.5,0.5 9.5,9.5 0.5,9.5 Z" Stroke="{StaticResource TextBrush}" StrokeThickness="1" Fill="Transparent" SnapsToDevicePixels="True" />
                    </Button>
                    <Button x:Name="CloseWindowButton" Style="{StaticResource WindowButton}" ToolTip="Close" Click="OnCloseClick">
                        <Path Width="10" Height="10" Data="M 0.8,0.8 L 9.2,9.2 M 9.2,0.8 L 0.8,9.2" Stroke="{StaticResource TextBrush}" StrokeThickness="1.2" SnapsToDevicePixels="True" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ListBox x:Name="ProjectTabs"
                         ItemsSource="{Binding Projects}"
                         SelectedItem="{Binding SelectedProject}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         AllowDrop="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,7,0" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <EventSetter Event="PreviewMouseMove" Handler="OnTabPreviewMouseMove" />
                            <EventSetter Event="Drop" Handler="OnTabDrop" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="TabChrome"
                                                Padding="11,7"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource StrokeBrightBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProjectTabViewModel}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="25" Height="25" CornerRadius="6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#143D59" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.VisualStudio2022}">
                                                    <Setter Property="Background" Value="#3D2761" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="9" FontFamily="Cascadia Code, Consolas" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&lt;&gt;" />
                                                <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.VisualStudio2022}">
                                                        <Setter Property="Text" Value="VS" />
                                                        <Setter Property="Foreground" Value="#C4A7FF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         MinWidth="70"
                                         MaxWidth="175"
                                         Margin="8,0,2,0"
                                         Padding="1"
                                         FontSize="12"
                                         FontWeight="SemiBold"
                                         ToolTip="Click to rename"
                                         LostKeyboardFocus="OnProjectNameLostFocus"
                                         KeyDown="OnProjectNameKeyDown" />
                                <Ellipse Width="6" Height="6" Margin="7,0,3,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFolderAvailable}" Value="False">
                                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Button Style="{StaticResource GhostButton}"
                                        Content="×"
                                        Margin="4,0,0,0"
                                        Padding="5,1"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        FontSize="15"
                                        ToolTip="Remove tab"
                                        Click="OnRemoveProjectClick" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Column="1"
                        Style="{StaticResource PrimaryButton}"
                        Content="＋  Add workspace"
                        Margin="8,0,10,0"
                        ToolTip="Add project (Ctrl+T)"
                        Command="{Binding AddProjectCommand}" />

                <Menu Grid.Column="2" VerticalAlignment="Center">
                    <MenuItem Header="•••" FontSize="16" Padding="12,7" ToolTip="Settings">
                        <MenuItem Header="Dark theme" IsCheckable="True" IsChecked="True" IsEnabled="False" />
                        <MenuItem Header="Window Manager mode" IsCheckable="True" IsChecked="True" IsEnabled="False" />
                    </MenuItem>
                </Menu>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="24">
            <Grid x:Name="EmptyState">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProject}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                    <Border Width="108" Height="108" Background="#121827" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="26">
                        <Image Source="/Assets/CodeDock.Mark.png" Width="82" Height="82" />
                    </Border>
                    <TextBlock Text="Your workspaces, one dock." FontSize="28" FontWeight="SemiBold" Margin="0,24,0,8" HorizontalAlignment="Center" />
                    <TextBlock Text="Bring every VS Code and Visual Studio project into a focused, persistent workspace."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="14"
                               LineHeight="22"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button Style="{StaticResource PrimaryButton}" Content="＋  Add your first workspace" Margin="0,24,0,0" Command="{Binding AddProjectCommand}" />
                    <TextBlock Text="Ctrl + T" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,12,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid x:Name="WorkspaceDashboard" DataContext="{Binding SelectedProject}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.65*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.ColumnSpan="3" Padding="28" Background="{StaticResource HeroGradient}" BorderBrush="#35415B" BorderThickness="1" CornerRadius="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Padding="8,4" Background="#21324A" CornerRadius="12">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="WORKSPACE READY" Foreground="{StaticResource SuccessBrush}" FontSize="9" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="30" FontWeight="SemiBold" Margin="0,13,0,5" />
                            <TextBlock Text="A focused home for this project and its preferred development environment."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13" />
                        </StackPanel>
                        <Image Grid.Column="1" Source="/Assets/CodeDock.Mark.png" Width="100" Height="100" Margin="30,-8,2,-8" Opacity="0.9" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="WORKSPACE DETAILS" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" Background="#182133" CornerRadius="7" VerticalAlignment="Top">
                                <TextBlock Text="⌁" Foreground="{StaticResource CyanBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Project folder" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                <TextBlock Text="{Binding FolderPath}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,22" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" Background="#132A29" CornerRadius="7" VerticalAlignment="Top">
                                <TextBlock Text="✓" Foreground="{StaticResource SuccessBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Local status" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                <TextBlock Margin="0,5,0,0" FontSize="13" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Folder available" />
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFolderAvailable}" Value="False">
                                                    <Setter Property="Text" Value="Folder unavailable" />
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="22">
                        <StackPanel>
                            <TextBlock Text="OPEN WITH" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="Preferred environment" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,3" />
                            <TextBlock Text="Choose which IDE will own this workspace."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" />
                            <Border Margin="0,18,0,0" Padding="3" Background="#0D1016" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Click="OnSelectVSCodeClick">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource EnvironmentButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.VisualStudioCode}">
                                                        <Setter Property="Background" Value="#163450" />
                                                        <Setter Property="BorderBrush" Value="#246694" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&lt;&gt;" FontFamily="Cascadia Code, Consolas" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" Margin="0,0,7,0" />
                                            <TextBlock Text="VS Code" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Click="OnSelectVisualStudioClick">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource EnvironmentButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PreferredEnvironment}" Value="{x:Static models:DevelopmentEnvironment.VisualStudio2022}">
                                                        <Setter Property="Background" Value="#342350" />
                                                        <Setter Property="BorderBrush" Value="#6843A0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="VS" Foreground="#C4A7FF" FontWeight="Bold" Margin="0,0,7,0" />
                                            <TextBlock Text="Visual Studio" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="22" Margin="0,18,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" Background="#261F38" CornerRadius="7" VerticalAlignment="Top">
                                <TextBlock Text="↗" Foreground="#C4A7FF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="IDE CONTROL" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="Bold" />
                                <TextBlock Text="Coming next" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,3" />
                                <TextBlock Text="Launch and reliably recall the correct VS Code or Visual Studio window."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           LineHeight="17"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="#0D1016" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="WINDOW MANAGER" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
