<Window x:Class="CodeDock.App.Views.WindowPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose IDE window"
        Width="620"
        Height="390"
        MinWidth="500"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Choose the correct IDE window" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1"
                   Text="CodeDock found multiple candidates and will not guess which one belongs to this workspace."
                   Foreground="{StaticResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,7,0,16" />

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Candidates}"
                 SelectedItem="{Binding SelectedCandidate}"
                 Background="{StaticResource SurfaceBrush}"
                 BorderBrush="{StaticResource StrokeBrush}"
                 BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="10,8">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ProcessId, StringFormat=Process {0}}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Margin="0,0,9,0" IsCancel="True" />
            <Button Style="{StaticResource PrimaryButton}" Content="Associate window" IsDefault="True" Click="OnAssociateClick" />
        </StackPanel>
    </Grid>
</Window>
